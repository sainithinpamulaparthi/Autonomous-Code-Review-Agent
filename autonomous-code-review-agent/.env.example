# --- GitHub (optional for public repos, required for private repos / posting PR comments) ---
GITHUB_TOKEN=
# Required only if you use the /webhook endpoint (must match the secret set in GitHub)
GITHUB_WEBHOOK_SECRET=

# --- SonarQube (optional) ---
SONAR_URL=http://localhost:9000
SONAR_TOKEN=
SONAR_PROJECT_KEY=

# --- LLM (optional): ollama | openai | none ---
LLM_PROVIDER=ollama
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_ISSUES=8

# --- Limits ---
MAX_FILES=25
MAX_FILE_BYTES=200000
